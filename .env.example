APP_NAME="Klinik Mahasiswa"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.vercel.app

LOG_CHANNEL=stderr
LOG_LEVEL=error

# ─── Railway MySQL ──────────────────────────────────────────────
# Salin nilai ini dari dashboard Railway > Your MySQL Service > Connect
DB_CONNECTION=mysql
DB_HOST=your-railway-host.railway.app
DB_PORT=3306
DB_DATABASE=railway
DB_USERNAME=root
DB_PASSWORD=your-railway-password

# ─── Cache & Session (Serverless-safe) ─────────────────────────
CACHE_DRIVER=array
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

# ─── Filesystem ────────────────────────────────────────────────
FILESYSTEM_DISK=local
